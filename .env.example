# Copia este archivo como .env y reemplaza los valores. El .env NO se sube a Git.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST/NOMBRE_BD?sslmode=require"
PORT=3000

# Verificación del celular por SMS con Textbee (https://textbee.dev): un celular Android con SIM peruana hace de pasarela.
# Estas claves son SECRETAS: van solo en tu .env y en el panel de Render, nunca en el código ni en Git.
TEXTBEE_API_KEY="pega_aqui_tu_clave_de_la_api"
TEXTBEE_DEVICE_ID="6aeb88fa14743c91efcee8f9"
# Opcional: SMS_MODO=simulado NO envía nada y escribe el código en la terminal (para programar sin gastar SMS).
# SMS_MODO=simulado
# Opcional: solo si Textbee cambia su dirección. Por defecto https://api.textbee.dev/api/v1/gateway/send-sms
# TEXTBEE_API_URL=

# Consulta de DNI y RUC con Factiliza (https://app.factiliza.com/api-consulta): trae los datos al registrarse un cliente.
# El token es SECRETO: va solo en tu .env y en el panel de Render, nunca en el código ni en Git.
# Si falta o falla, el chat le pide los datos a la persona a mano.
FACTILIZA_TOKEN="pega_aqui_tu_token_de_factiliza"
# Opcional: CONSULTA_MODO=simulado usa datos inventados y no gasta consultas (solo para programar, nunca con clientes reales).
# CONSULTA_MODO=simulado
